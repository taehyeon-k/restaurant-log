+// [DINARY patch] renderInContext ignores zPosition and paints sublayers in array order. RN Fabric draws
+// backgrounds/borders it can't put on the view's own layer (a border without clipping, uneven corner radii)
+// on extra sublayers appended after the content and pushed behind it with a negative zPosition, so in the
+// snapshot the opaque background covered all text. Reorder those non-view layers the way the screen
+// composites them: negative zPosition to the back, positive to the front. Views' own layers keep their order.
+static void RNCNaverMapOrderLayersByZ(CALayer* layer) {
+  NSArray<CALayer*>* sublayers = [layer.sublayers copy];
+  NSMutableArray<CALayer*>* back = [NSMutableArray new];
+  NSMutableArray<CALayer*>* front = [NSMutableArray new];
+  for (CALayer* sublayer in sublayers) {
+    if ([sublayer.delegate isKindOfClass:[UIView class]]) {
+      continue;
+    }
+    if (sublayer.zPosition < 0) {
+      [back addObject:sublayer];
+    } else if (sublayer.zPosition > 0) {
+      [front addObject:sublayer];
+    }
+  }
+  NSComparator byZ = ^NSComparisonResult(CALayer* a, CALayer* b) {
+    if (a.zPosition < b.zPosition) return NSOrderedAscending;
+    if (a.zPosition > b.zPosition) return NSOrderedDescending;
+    return NSOrderedSame;
+  };
+  [back sortWithOptions:NSSortStable usingComparator:byZ];
+  [front sortWithOptions:NSSortStable usingComparator:byZ];
+  unsigned int index = 0;
+  for (CALayer* sublayer in back) {
+    [layer insertSublayer:sublayer atIndex:index++];
+  }
+  for (CALayer* sublayer in front) {
+    [layer addSublayer:sublayer];
+  }
+}
+
+// [DINARY patch] renderInContext uses whatever a layer has drawn so far — force pending drawing first.
+static void RNCNaverMapDisplayLayerTree(CALayer* layer) {
+  RNCNaverMapOrderLayersByZ(layer);
+  [layer displayIfNeeded];
+  for (CALayer* sublayer in layer.sublayers) {
+    RNCNaverMapDisplayLayerTree(sublayer);
+  }
 }
 
